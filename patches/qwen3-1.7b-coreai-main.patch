diff --git a/python/tests/test_model_units/test_export/test_llm_export.py b/python/tests/test_model_units/test_export/test_llm_export.py
new file mode 100644
index 0000000..0886f5f
--- /dev/null
+++ b/python/tests/test_model_units/test_export/test_llm_export.py
@@ -0,0 +1,51 @@
+# Copyright 2026 massif-01
+#
+# Use of this source code is governed by a BSD-3-clause license that can
+# be found in the LICENSE file or at https://opensource.org/licenses/BSD-3-Clause
+
+"""Tests for LLM export preset resolution and recipe contracts."""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+import yaml
+
+from coreai_models.llm.export import _resolve_export_config, build_parser
+
+
+@pytest.mark.parametrize("model", ["qwen3-1.7b", "Qwen/Qwen3-1.7B"])
+def test_qwen3_1_7b_experimental_preset_requires_opt_in(model: str) -> None:
+    args = build_parser().parse_args([model, "--platform", "iOS"])
+
+    with pytest.raises(SystemExit, match="uses an experimental registry preset"):
+        _resolve_export_config(args)
+
+
+def test_qwen3_1_7b_preset_resolves_locked_ios_recipe() -> None:
+    args = build_parser().parse_args(["qwen3-1.7b", "--platform", "iOS", "--experimental"])
+
+    config = _resolve_export_config(args)
+
+    assert config.hf_model_id == "Qwen/Qwen3-1.7B"
+    assert config.variant == "iOS"
+    assert config.compute_precision == "float16"
+    assert config.max_context_length == 4096
+    assert config.disable_embedding_quantization is False
+
+
+def test_qwen3_1_7b_recipe_contract() -> None:
+    repo_root = Path(__file__).resolve().parents[4]
+    recipe_path = repo_root / "models/qwen3/qwen3_1_7b_w8_per_tensor.yaml"
+    recipe = yaml.safe_load(recipe_path.read_text())
+    palettization = recipe["kmeans_palettization_config"]
+
+    assert palettization["global_config"]["op_state_spec"]["weight"] == {
+        "n_bits": 8,
+        "granularity": {"type": "per_tensor"},
+    }
+    assert palettization["module_type_configs"] == {
+        "torch.nn.modules.sparse.Embedding": None,
+        "coreai_models.primitives.ios.embedding.LoadEmbeddings": None,
+    }
